{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/jaipur-bus-routes",
        "destination": "/pages/jaipur-bus-routes/index.html"
      },
      {
        "source": "/jaipur-bus-routes/",
        "destination": "/pages/jaipur-bus-routes/index.html"
      },
      {
        "source": "/jaipur-bus-routes/**",
        "destination": "/pages/jaipur-bus-routes/index.html"
      },
      {
        "source": "/jaipur-metro-guide",
        "destination": "/pages/jaipur-metro-guide/index.html"
      },
      {
        "source": "/jaipur-metro-guide/",
        "destination": "/pages/jaipur-metro-guide/index.html"
      },
      {
        "source": "/jaipur-metro-guide/**",
        "destination": "/pages/jaipur-metro-guide/index.html"
      },
      {
        "source": "/jctsl-live-bus-tracking",
        "destination": "/pages/jctsl-live-bus-tracking/index.html"
      },
      {
        "source": "/jctsl-live-bus-tracking/",
        "destination": "/pages/jctsl-live-bus-tracking/index.html"
      },
      {
        "source": "/jctsl-live-bus-tracking/**",
        "destination": "/pages/jctsl-live-bus-tracking/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/ai-catalog.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/.well-known/ai-catalog.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/ai-catalog.schema.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/favicon-48.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/apple-touch-icon.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/metro",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/metro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
